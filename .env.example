# Copy this file to .env and replace the placeholder values.

SNOWFLAKE_ACCOUNT=your_organization-your_account
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=replace_with_your_password

# Project resources created by the infrastructure scripts.
SNOWFLAKE_ROLE=NFL_LOADER_ROLE
SNOWFLAKE_WAREHOUSE=NFL_ANALYTICS_WH
SNOWFLAKE_DATABASE=NFL_INJURY_ANALYSIS
SNOWFLAKE_SCHEMA=RAW
